{
  "name": "fizika-qainau-online",
  "private": true,
  "description": "Қайнау сабағын бағалау — мұғалім мен 4 топ бір уақытта жұмыс істейтін онлайн нұсқа (Firebase)",
  "scripts": {
    "test:rules": "firebase emulators:exec --only firestore --project demo-qainau \"node --test tests/rules.test.mjs\"",
    "test:e2e": "firebase emulators:exec --only firestore,auth --project demo-qainau \"node tests/e2e.mjs\"",
    "test": "npm run test:rules && npm run test:e2e",
    "deploy": "firebase deploy --only firestore:rules,hosting"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase": "12.19.0",
    "firebase-tools": "^15.0.0",
    "playwright": "^1.56.0",
    "qrcode-generator": "1.4.4"
  }
}
